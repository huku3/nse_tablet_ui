# リリース署名の設定例。これをコピーして keystore.properties を作成してください。
#   copy keystore.properties.example keystore.properties
# 値を実際のキーストア情報に置き換えます。keystore.properties と .jks は
# Git にコミットしないでください（.gitignore 済み）。必ず安全な場所にバックアップを。
#
# キーストア生成コマンド（プロジェクト直下で実行・JDK同梱のkeytoolを使用）:
#   & "$env:JAVA_HOME\bin\keytool.exe" -genkeypair -v `
#       -keystore nse-worker-release.jks -alias nse-worker `
#       -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=nse-worker-release.jks
storePassword=ここにキーストアのパスワード
keyAlias=nse-worker
keyPassword=ここに鍵のパスワード
